datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("notes_db_PRISMA_DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  vaultPassword String?   // Hashed master password
  themeConfig   String?   @db.Text // JSON string for Discord Nitro-style custom theme settings
  accounts      Account[]
  sessions      Session[]
  notes         Note[]
  todos         Todo[]
}

model Note {
  id            String   @id @default(cuid())
  title         String
  content       String   @db.Text
  encryptedData String?  @db.Text
  color         String?  // Optional color accent: "red" | "blue" | "green" | "yellow" | "purple" | null
  tags          String   @default("")  // Comma-separated tag list e.g. "work,personal"
  isPinned      Boolean  @default(false)
  isLocked      Boolean  @default(false)
  isDeleted     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Todo {
  id          String    @id @default(cuid())
  title       String
  description String?   @db.Text
  isCompleted Boolean   @default(false)
  priority    String    @default("medium") // low, medium, high, urgent
  dueDate     DateTime?
  tags        String    @default("")
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationCode {
  id        String   @id @default(cuid())
  email     String   @unique
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

